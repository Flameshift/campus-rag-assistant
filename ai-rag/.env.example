# 大模型配置（DeepSeek / 通义 / OpenAI 兼容接口均可）
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Spring Boot -> Python 内部认证，生产环境必须覆盖默认密钥
INTERNAL_AUTH_REQUIRED=true
INTERNAL_AUTH_SECRET=local-dev-internal-auth-secret
INTERNAL_AUTH_MAX_SKEW_SECONDS=300

# Embedding 配置
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=25
EMBEDDING_MAX_CONCURRENCY=3
EMBEDDING_QUERY_BATCH_ENABLED=true

# RAG 参数
VECTOR_DB_DIR=./data/chroma_qwen
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=5

# 结构化摄取
CHUNK_INCLUDE_SECTION_PATH=true
CHUNK_RECORD_MAX_SIZE=1200
CHUNK_TABLE_ROWS_PER_GROUP=12
PARSER_VERSION=v2
CHUNKER_VERSION=v2

# 低置信度文档的大模型结构规划，仅输出分块边界，不重写原文
STRUCTURE_LLM_ENABLED=true
STRUCTURE_LLM_MODEL=deepseek-chat
STRUCTURE_LLM_MIN_CONFIDENCE=0.65
STRUCTURE_LLM_MAX_BLOCKS_PER_CALL=80
STRUCTURE_LLM_CACHE_SIZE=128

# 命中分块的相邻窗口扩展
NEIGHBOR_EXPANSION_ENABLED=true
# 父级扩展成功后跳过相邻扩展，父级不可用时才使用相邻块兜底
NEIGHBOR_CONDITIONAL_ENABLED=true
NEIGHBOR_EXPANSION_WINDOW=1
NEIGHBOR_EXPANSION_MAX_ADDED=3

# 父级分组和检索时父上下文扩展
PARENT_GROUP_TARGET_CHARS=2400
PARENT_GROUP_MAX_CHILDREN=8
PARENT_EXPANSION_ENABLED=true
PARENT_EXPANSION_MAX_ADDED=6
PARENT_EXPANSION_MAX_CHILDREN=6
PARENT_EXPANSION_MAX_CHARS=3000
# Evidence Object 证据合并
EVIDENCE_OBJECT_ENABLED=true
EVIDENCE_OBJECT_MAX_CHILDREN=8
EVIDENCE_OBJECT_MAX_CHARS=4000

# 多轮追问检索改写
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=deepseek-chat
QUERY_REWRITE_MAX_HISTORY=6
QUERY_REWRITE_CACHE_SIZE=256
QUERY_REWRITE_TIMEOUT=30
QUERY_REWRITE_STANDALONE_ENABLED=true
QUERY_REWRITE_LONG_THRESHOLD=160
QUERY_REWRITE_MAX_QUERY_CHARS=500
# 领域口语/简称映射，使用分号分隔多个 "原词=标准术语"
QUERY_ALIASES=

# 查询规划和子问题证据补召回
QUERY_PLANNER_ENABLED=true
QUERY_CLARIFICATION_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_MAX_QUERIES=3
MULTI_QUERY_MAX_WORKERS=3
MULTI_QUERY_RRF_K=60
MULTI_QUERY_SECONDARY_WEIGHT=0.85
EVIDENCE_COVERAGE_ENABLED=true
EVIDENCE_COVERAGE_MAX_SUBQUESTIONS=3
EVIDENCE_COVERAGE_TOP_K=4
EVIDENCE_COVERAGE_MAX_ADDED=4

# 回答完整性复核与一次补全
ANSWER_VERIFICATION_ENABLED=true
ANSWER_VERIFICATION_MODEL=deepseek-chat
ANSWER_VERIFICATION_TIMEOUT=30
ANSWER_NUMERIC_VALIDATION_ENABLED=true

# 请求级 RAG Trace，仅建议评测或排查时开启
RAG_TRACE_ENABLED=false
RAG_TRACE_DIR=./data/rag_traces
RAG_TRACE_RETENTION_DAYS=7
RAG_TRACE_MAX_FILES=500
RAG_TRACE_MAX_TOTAL_BYTES=52428800

# 短期会话记忆
SHORT_TERM_MEMORY_ENABLED=true
SHORT_TERM_MEMORY_MAX_MESSAGES=20
SHORT_TERM_CONTEXT_MESSAGES=6
SHORT_TERM_MEMORY_TTL_HOURS=72
SHORT_TERM_MEMORY_CLEANUP_INTERVAL_SECONDS=3600

# 综合置信度阈值
CONFIDENCE_ENABLED=true
CONFIDENCE_HIGH_THRESHOLD=0.78
CONFIDENCE_VERIFY_THRESHOLD=0.62
CONFIDENCE_RETRIEVE_THRESHOLD=0.45

# 混合检索（BM25 + 向量）
BM25_ENABLED=true
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
RETRIEVE_CANDIDATES=20

# 语义去重
SEMANTIC_DEDUP_ENABLED=true
SEMANTIC_DEDUP_THRESHOLD=0.75
SEMANTIC_DEDUP_GRAY_LOW=0.60
SEMANTIC_DEDUP_TOP_K=3
SEMANTIC_DEDUP_LLM_CONFIRM=true
SEMANTIC_DEDUP_JUDGE_MODEL=deepseek-chat

# Rerank 精排
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_CANDIDATES=20
RERANK_TIMEOUT=20

# RAGAS 旁路 Judge，与在线回答模型分开配置
RAGAS_LLM_MODEL=qwen-flash
RAGAS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAGAS_LLM_API_KEY=

# 数据库：默认 SQLite；生产可切换 MySQL
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_rag?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db
